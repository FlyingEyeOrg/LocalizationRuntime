<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LocalizationRuntime.Tests</RootNamespace>
    <AssemblyName>LocalizationRuntime.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- 依赖注入测试需要真正的容器（ServiceCollection / BuildServiceProvider） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试用的资源集：覆盖标量、嵌套对象、字符串数组、对象数组、嵌套数组 -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\Localization\*.json" />
    <!-- 值校验测试需要读取原始 JSON 做三方比对 -->
    <None Include="$(MSBuildProjectDirectory)\Localization\*.json"
          CopyToOutputDirectory="PreserveNewest"
          Link="Localization\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalizationRuntime\LocalizationRuntime.csproj" />
    <ProjectReference Include="..\..\src\LocalizationRuntime.Generator\LocalizationRuntime.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
