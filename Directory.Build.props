<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>FlyingEyeOrg</Company>
    <Authors>FlyingEyeOrg</Authors>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/FlyingEyeOrg/LocalizationRuntime</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <!--
    仓库内直接复用包里那两份构建文件，保证"本地开发"和"装 NuGet 包"走同一套逻辑，
    不会出现两边行为不一致。用户项目则由 NuGet 自动导入 build/ 下的同名文件。
  -->
  <Import Project="$(MSBuildThisFileDirectory)src\LocalizationRuntime.Generator\build\LocalizationRuntime.Generator.props" />

</Project>
