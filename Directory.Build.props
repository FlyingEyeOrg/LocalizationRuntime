<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>FlyingEyeOrg</Company>
    <Authors>FlyingEyeOrg</Authors>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/FlyingEyeOrg/LocalizationRuntime</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <!--
    本地化配置。资源目录默认 Localization/，文件名即 culture（zh-CN.json）。
    基语言既是键集合的定义处，也是其它语言缺键时的回退目标。
  -->
  <PropertyGroup>
    <LocalizationDirectory Condition="'$(LocalizationDirectory)' == ''">Localization</LocalizationDirectory>
    <LocalizationDefaultCulture Condition="'$(LocalizationDefaultCulture)' == ''">zh-CN</LocalizationDefaultCulture>
    <LocalizationClassName Condition="'$(LocalizationClassName)' == ''">L</LocalizationClassName>
    <LocalizationNamespaceSuffix Condition="'$(LocalizationNamespaceSuffix)' == ''">.Localization</LocalizationNamespaceSuffix>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace" />
    <CompilerVisibleProperty Include="LocalizationDefaultCulture" />
    <CompilerVisibleProperty Include="LocalizationClassName" />
    <CompilerVisibleProperty Include="LocalizationNamespaceSuffix" />
  </ItemGroup>

  <!--
    项目目录下存在资源目录时才挂到编译输入上；没有该目录的项目完全不受影响。
    生成器只能看到 AdditionalFiles 里的文件，这是整条链路的入口。
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\$(LocalizationDirectory)')">
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\$(LocalizationDirectory)\*.json" />
  </ItemGroup>

</Project>
