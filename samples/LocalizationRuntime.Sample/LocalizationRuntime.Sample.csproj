<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LocalizationRuntime.Sample</RootNamespace>
    <AssemblyName>LocalizationRuntime.Sample</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 便于排查生成物；正式项目不需要开。 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <!-- 示例刻意让 ja-JP 缺 Common.Cancel 以演示回退，这条诊断是预期行为。 -->
    <LocalizationSuppressedDiagnostics>LR1006</LocalizationSuppressedDiagnostics>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalizationRuntime\LocalizationRuntime.csproj" />
    <ProjectReference Include="..\..\src\LocalizationRuntime.Generator\LocalizationRuntime.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>


