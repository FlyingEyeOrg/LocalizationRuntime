<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyName>LocalizationRuntime</AssemblyName>
    <RootNamespace>LocalizationRuntime</RootNamespace>
    <PackageId>LocalizationRuntime</PackageId>
    <Title>LocalizationRuntime</Title>
    <Description>编译期固化多语言资源的 .NET 本地化运行时：运行时零文件 IO，按 CultureInfo 链回退取值。</Description>
    <PackageTags>localization;i18n;l10n;culture;source-generator</PackageTags>
    <PackageProjectUrl>https://github.com/FlyingEyeOrg/LocalizationRuntime</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      生成器会在使用方程序集里产出一个 AddLocalizationRuntime() 扩展方法，
      它需要 IServiceCollection。这里声明依赖，使用方就能通过本包传递拿到该类型，
      不必自己再引一次。
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
  </ItemGroup>

</Project>
